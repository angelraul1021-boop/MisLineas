# Sitios de otros proyectos que comparten este mismo Caddy (puertos 80/443 del
# VPS solo pueden tener un dueño). Cada archivo .caddy en ./sites se genera y
# versiona desde su propio repo — hoy solo VIA (infra/osrm-proxy en el repo
# VIA-SaaS) los publica ahí, sin que este repo necesite saber nada de VIA más
# allá de esta línea.
import /etc/caddy/sites/*.caddy
